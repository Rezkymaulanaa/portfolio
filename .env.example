# Copy this file to .env.local and fill in the values.
# .env.local is ignored by Git and must never be committed.

# From https://www.sanity.io/manage → your project → "Project ID"
NEXT_PUBLIC_SANITY_PROJECT_ID=
# Dataset name (usually "production")
NEXT_PUBLIC_SANITY_DATASET=production

# Only needed to run the seed script (Phase 2).
# Create it at sanity.io/manage → API → Tokens → "Add API token" with "Editor" permission.
SANITY_API_WRITE_TOKEN=

# "Let's Talk" message panel (free Resend account: https://resend.com)
# API key: resend.com → API Keys → Create API Key ("Sending access").
RESEND_API_KEY=
# Where messages are delivered. Without your own domain this MUST be the
# same email as your Resend account.
CONTACT_TO_EMAIL=
